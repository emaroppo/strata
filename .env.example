# Copy to .env — docker compose reads it automatically.
# Gitignored, because the project path names a real job.

# Where the catalog lives; its blobs/ is what Label Studio serves from.
STRATA_CATALOG=./catalog

# The pre-catalog data root, mounted only so tasks created before the
# cutover keep resolving. Point it at your project, or delete the legacy
# mount from docker-compose.yml once nothing needs it.
AUTO_LABELLER_PROJECT=projects/my-project
