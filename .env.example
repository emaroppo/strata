# Copy to .env — docker compose reads it automatically.
# Gitignored, because the project path names a real job.

# Where the catalog lives; its blobs/ is what Label Studio serves from.
STRATA_CATALOG=./catalog

# Only needed if you uncomment the legacy mount in docker-compose.yml, which
# makes a Label Studio project created before the cutover show its images
# again. The current loop does not use it.
# AUTO_LABELLER_PROJECT=projects/my-project

# The catalog index. Postgres runs in the compose stack; point the catalog
# at it with [catalog] url in config.toml. Credentials live here rather than
# in config.toml so compose and the client read the same values.
STRATA_DB_USER=strata
STRATA_DB_PASSWORD=strata
STRATA_DB_NAME=strata
STRATA_DB_PORT=5432
