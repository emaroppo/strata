# Project payload — ignored wherever a project lives (projects/<name>/ or elsewhere).
# Each project's project.toml and model.py stay in version control.
data/
dataset.json
checkpoints/
rounds/
.state/
# Pre-project checkpoint dir; anchored so it can't match auto_labeller/models/
/models/
# A local catalog: SQLite index plus the blobs. Anchored, or it would also
# swallow packages/catalog/, which is the source. The suffixed form is for a
# host holding more than one.
/catalog/
/catalog-*/

# Corpora waiting to be imported. Raw source data belongs beside the repo,
# never in it: it is large, and it is usually somebody's.
/ner_data/
# Project payload again: the run store and the materialised dataset versions
# a round writes. Unanchored like checkpoints/ and rounds/, since they live
# wherever a project does.
runs/
datasets/

config*.toml
!config.example.toml
# Names entries in one operator's password manager, so it describes a person
# rather than the project. The variables it sets are the contract; how any
# given host fills them is that host's business.
/scripts/secrets.sh
# Which project and catalog docker compose mounts. Holds a real project
# path, so it stays local like config.toml does.
.env
!.env.example
__pycache__/
*.pyc
.venv/
projects/*
