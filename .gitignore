# Project payload — ignored wherever a project lives (projects/<name>/ or elsewhere).
# Each project's project.toml and model.py stay in version control.
data/
dataset.json
checkpoints/
rounds/
.state/
# Pre-project checkpoint dir; anchored so it can't match auto_labeller/models/
/models/
# A local catalog: SQLite index plus the blobs. Anchored, or it would also
# swallow packages/catalog/, which is the source.
/catalog/
# Run store written beside a catalog by `RunStore.local`
/runs/

config*.toml
!config.example.toml
__pycache__/
*.pyc
.venv/
projects/*
